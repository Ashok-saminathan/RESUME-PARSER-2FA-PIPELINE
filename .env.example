APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/onboarding
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
TOTP_ISSUER=EdTech Onboarding

# Development only: return the OTP in the register response so cURL/Postman tests work.
# Must be false in production (the app refuses to start otherwise).
DEBUG_RETURN_OTP=true

# Email OTP via SMTP (optional in development: OTP is logged to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# WhatsApp OTP via Meta Cloud API (optional in development)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_verification
